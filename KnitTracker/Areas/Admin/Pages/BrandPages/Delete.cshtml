@page
@model KnitTracker.Areas.Admin.Pages.BrandPages.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4> Brand</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Brand.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Brand.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Brand.Country)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Brand.Country)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Brand.Yarns)
        </dt>
        <dd class = "col-sm-10">
            <ul class="list-unstyled">
                @foreach (var item in Model.Brand.Yarns)
                {
                    <li>@item.Name</li>
                }
            </ul>
        </dd>
    </dl>
    <form method="post">
        <input type="hidden" asp-for="Brand.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
