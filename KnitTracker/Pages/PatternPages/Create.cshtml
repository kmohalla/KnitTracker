@page
@model KnitTracker.Pages.PatternPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Pattern</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Pattern.Name" class="control-label"></label>
                <input asp-for="Pattern.Name" class="form-control" />
                <span asp-validation-for="Pattern.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pattern.Designer" class="control-label"></label>
                <input asp-for="Pattern.Designer" class="form-control" />
                <span asp-validation-for="Pattern.Designer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pattern.Category" class="control-label"></label>
                <input asp-for="Pattern.Category" class="form-control" />
                <span asp-validation-for="Pattern.Category" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Pattern.Difficulty" class="control-label"></label>
                <input asp-for="Pattern.Difficulty" class="form-control" />
                <span asp-validation-for="Pattern.Difficulty" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
