@page
@model KnitTracker.Pages.YarnPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<form>
    <p>
        <label> Search </label>
        <label> Name: <input type="text" asp-for="NameSearchString"/> Fiber: <input type="text" asp-for="FiberSearchString" /> Color: <input type="text" asp-for="ColorSearchString" /> <input type="submit" value="Filter" /> <a asp-page="./Index">Clear</a></label> 
    </p>
</form>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].Fiber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].Weight)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].ColorName)
            </th>
            
            <th>
                @Html.DisplayNameFor(model => model.Yarn[0].Brand)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Yarn) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Name)
            </td>
            <td>
                @Html.DisplayFor(model => item.Fiber)
            </td>
            <td>
                @Html.DisplayFor(model => item.Weight)
            </td>
            <td>
                @Html.DisplayFor(model => item.ColorName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Brand!.Name)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
