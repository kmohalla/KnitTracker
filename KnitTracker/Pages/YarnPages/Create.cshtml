@page
@model KnitTracker.Pages.YarnPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Yarn</h4>
<hr />
<div class="row">
    <div-- class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Yarn.Name" class="control-label"></label>
                <input asp-for="Yarn.Name" class="form-control" />
                <span asp-validation-for="Yarn.Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.Fiber" class="control-label"></label>
                <input asp-for="Yarn.Fiber" class="form-control" />
                <span asp-validation-for="Yarn.Fiber" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.Weight" class="control-label"></label>
                <input asp-for="Yarn.Weight" class="form-control" />
                <span asp-validation-for="Yarn.Weight" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.ColorName" class="control-label"></label>
                <input asp-for="Yarn.ColorName" class="form-control" />
                <span asp-validation-for="Yarn.ColorName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Yarn.Brand" class="control-label"></label>
                <select asp-for="Yarn.BrandId" class="form-control" asp-items="@Model.BrandNameSL">
                <option value="">--Select Brand--</option>
                </select>
                <span asp-validation-for="Yarn.BrandId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
            <div>
                <a asp-page="./Index">Back to List</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
